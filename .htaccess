# Halfman Engineering - Production Apache Configuration
# Clean URL Rewrites, Security Headers, 404 Error Handling, and Compression

DirectoryIndex index.html

# Custom 404 Error Page
ErrorDocument 404 /404.html

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# Enable Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# URL Rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Enforce preferred domain (non-www halfman-engineering.com)
  RewriteCond %{HTTP_HOST} ^www\.halfman-engineering\.com$ [NC]
  RewriteRule ^(.*)$ https://halfman-engineering.com/$1 [R=301,L]

  # Redirect /index.html and /index to root / (resolves GSC Alternate Page with Proper Canonical Tag)
  RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?[\s?] [NC]
  RewriteRule ^index(?:\.html)?$ / [R=301,L]

  # Exclude 404.html from rewrite loop
  RewriteCond %{REQUEST_URI} ^/404\.html$
  RewriteRule .* - [L]

  # Support extensionless URLs internally while preserving .html canonical URLs
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>